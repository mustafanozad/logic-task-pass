{
  "name": "employee-management-system",
  "version": "1.0.0",
  "description": "نظام إدارة الموظفين وحساب العلاوات والترفيعات",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "npm start --prefix client",
    "build": "npm run build --prefix client",
    "install-client": "npm install --prefix client"
  },
  "keywords": ["employee", "management", "promotions", "bonuses"],
  "author": "Codegen",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "moment": "^2.29.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.0"
  }
}
